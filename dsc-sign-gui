class DraggableBox:
    """A draggable/resizable rectangle on a Tkinter Canvas.

    Optionally aspect-locked (resize preserves width/height ratio) and
    showing a faded preview of a stamp image so placement is visible.
    """

    EDGE_THRESHOLD = 12  # pixels from an edge that still counts as "resize"
    GRIP = 16            # size of the visible corner resize handle
    MIN_W = 40           # smallest box width  (px)
    MIN_H = 20           # smallest box height (px)

    def __init__(self, canvas, x, y, w, h, on_move=None,
                 aspect=None, label_text="Signature", color="#d32f2f",
                 pil_image=None):
        self.canvas = canvas
        self.on_move = on_move
        self.aspect = aspect            # width / height, or None = free resize
        self.color = color
        self.x, self.y, self.w, self.h = x, y, w, h
        self._src_image = pil_image     # full-res PIL image for the preview
        self._photo = None              # keeps the ImageTk ref alive
        self.image = None               # canvas image item id

        if self._src_image is not None:
            self.image = canvas.create_image(x, y, anchor=tk.NW)
        self.rect = canvas.create_rectangle(
            x, y, x + w, y + h,
            outline=color, width=2, dash=(6, 3),
        )
        self.label = None
        if label_text:
            self.label = canvas.create_text(
                x + w / 2, y + 9,
                text=label_text, fill=color, font=("Sans", 9, "bold"),
            )
        # Visible bottom-right resize handle — a big, obvious drag target.
        g = self.GRIP
        self.grip = canvas.create_rectangle(
            x + w - g, y + h - g, x + w, y + h,
            fill=color, outline="white", width=2,
        )
        self._drag_data = None

        for item in (self.image, self.rect, self.label):
            if item is None:
                continue
            canvas.tag_bind(item, "<ButtonPress-1>", self._on_press)
            canvas.tag_bind(item, "<B1-Motion>", self._on_drag)
            canvas.tag_bind(item, "<ButtonRelease-1>", self._on_release)
            canvas.tag_bind(item, "<Motion>", self._on_hover)
            canvas.tag_bind(item, "<Leave>", self._on_leave)
        canvas.tag_bind(self.grip, "<ButtonPress-1>", self._on_grip_press)
        canvas.tag_bind(self.grip, "<B1-Motion>", self._on_drag)
        canvas.tag_bind(self.grip, "<ButtonRelease-1>", self._on_release)
        canvas.tag_bind(self.grip, "<Enter>",
                        lambda e: canvas.config(cursor="bottom_right_corner"))
        canvas.tag_bind(self.grip, "<Leave>", self._on_leave)
        self._render_image()

    def _render_image(self):
        """(Re)scale the preview image to the current box size, faded."""
        if self._src_image is not None:
            w, h = max(1, int(self.w)), max(1, int(self.h))
            scaled = self._src_image.resize((w, h), Image.LANCZOS)
            alpha = scaled.split()[-1].point(lambda a: int(a * 0.55))
            scaled.putalpha(alpha)
            self._photo = ImageTk.PhotoImage(scaled)
            self.canvas.itemconfigure(self.image, image=self._photo)
            self.canvas.tag_raise(self.rect, self.image)
            if self.label is not None:
                self.canvas.tag_raise(self.label, self.rect)
        self.canvas.tag_raise(self.grip)  # handle stays on top, always grabbable

    def _hit_edge(self, ex, ey):
        t = self.EDGE_THRESHOLD
        on_right = abs(ex - (self.x + self.w)) < t
        on_bottom = abs(ey - (self.y + self.h)) < t
        in_y = self.y - t <= ey <= self.y + self.h + t
        in_x = self.x - t <= ex <= self.x + self.w + t
        if on_right and on_bottom:
            return "br"
        if on_right and in_y:
            return "r"
        if on_bottom and in_x:
            return "b"
        return None

    def _on_hover(self, event):
        """Show a resize or move cursor depending on the pointer position."""
        if self._drag_data:
            return
        cursors = {"br": "bottom_right_corner", "r": "sb_h_double_arrow",
                   "b": "sb_v_double_arrow"}
        self.canvas.config(
            cursor=cursors.get(self._hit_edge(event.x, event.y), "fleur"))

    def _on_leave(self, _event):
        if not self._drag_data:
            self.canvas.config(cursor="crosshair")

    def _on_press(self, event):
        self._begin_drag(event, self._hit_edge(event.x, event.y))

    def _on_grip_press(self, event):
        self._begin_drag(event, "br")

    def _begin_drag(self, event, edge):
        self._drag_data = {
            "sx": event.x, "sy": event.y,
            "ox": self.x, "oy": self.y,
            "ow": self.w, "oh": self.h,
            "edge": edge,
        }

    def _on_drag(self, event):
        if not self._drag_data:
            return
        d = self._drag_data
        dx = event.x - d["sx"]
        dy = event.y - d["sy"]
        edge = d["edge"]
        if edge is None:
            # Move
            self.x = d["ox"] + dx
            self.y = d["oy"] + dy
        else:
            if "r" in edge:
                self.w = max(self.MIN_W, d["ow"] + dx)
            if "b" in edge:
                self.h = max(self.MIN_H, d["oh"] + dy)
            if self.aspect:
                # Aspect-lock: derive the other dimension.
                if "r" in edge:
                    self.h = self.w / self.aspect
                else:
                    self.w = self.h * self.aspect
        self._update(rescale=False)

    def _on_release(self, _event):
        self._drag_data = None
        self._render_image()

    def _update(self, rescale=True):
        self.canvas.coords(self.rect, self.x, self.y,
                           self.x + self.w, self.y + self.h)
        if self.label is not None:
            self.canvas.coords(self.label, self.x + self.w / 2, self.y + 9)
        g = self.GRIP
        self.canvas.coords(self.grip,
                           self.x + self.w - g, self.y + self.h - g,
                           self.x + self.w, self.y + self.h)
        if self.image is not None:
            self.canvas.coords(self.image, self.x, self.y)
            if rescale:
                self._render_image()
        self.canvas.tag_raise(self.grip)
        if self.on_move:
            self.on_move()

    def reposition(self, x, y, w, h):
        self.x, self.y, self.w, self.h = x, y, w, h
        self._update(rescale=True)


def run_gs_compress(inp, out, settings_or_resolution):
    import subprocess
    if isinstance(settings_or_resolution, str):
        cmd = [
            "gs", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.4",
            f"-dPDFSETTINGS={settings_or_resolution}", "-dNOPAUSE", "-dQUIET",
            "-dBATCH", f"-sOutputFile={out}", str(inp)
        ]
    else:
        res = settings_or_resolution
        cmd = [
            "gs", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.4",
            "-dNOPAUSE", "-dQUIET", "-dBATCH",
            "-dColorImageDownsampleType=/Bicubic", f"-dColorImageResolution={res}",
            "-dGrayImageDownsampleType=/Bicubic", f"-dGrayImageResolution={res}",
            "-dMonoImageDownsampleType=/Bicubic", f"-dMonoImageResolution={res}",
            f"-sOutputFile={out}", str(inp)
        ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    return res.returncode == 0


def compress_to_target_size(inp, out, target_kb):
    import tempfile
    import shutil
    from pathlib import Path
    
    attempts = ["/printer", "/ebook", "/screen", 50, 30]
    best_temp = None
    best_size = None
    
    for setting in attempts:
        fd, temp_path = tempfile.mkstemp(suffix=".pdf")
        os.close(fd)
        t_path = Path(temp_path)
        
        try:
            success = run_gs_compress(inp, t_path, setting)
            if success and t_path.exists():
                size_kb = t_path.stat().st_size / 1024.0
                if size_kb <= target_kb:
                    shutil.copy(str(t_path), str(out))
                    t_path.unlink()
                    if best_temp and best_temp.exists():
                        best_temp.unlink()
                    return True
                
                if best_size is None or size_kb < best_size:
                    if best_temp and best_temp.exists():
                        best_temp.unlink()
                    best_temp = t_path
                    best_size = size_kb
                else:
                    t_path.unlink()
        except Exception:
            if t_path.exists():
                t_path.unlink()
                
    if best_temp and best_temp.exists():
        shutil.copy(str(best_temp), str(out))
        best_temp.unlink()
        return True
    return False


class PDFSignerApp(tk.Tk):
    def _get_optimized_signature_image(self, img_path):
        """Optimizes a signature image to prevent PDF bloat.
        Resizes large images to max 800px width/height and saves to a temp PNG.
        Returns Path of optimized image (caller should cleanup), or original path.
        """
        import tempfile
        from PIL import Image
        
        path_obj = Path(img_path)
        if not path_obj.exists():
            return path_obj
            
        try:
            if path_obj.stat().st_size < 100 * 1024:
                return path_obj
                
            with Image.open(path_obj) as im:
                max_dim = 800
                w, h = im.size
                if w > max_dim or h > max_dim:
                    if w > h:
                        new_w = max_dim
                        new_h = int(h * (max_dim / w))
                    else:
                        new_h = max_dim
                        new_w = int(w * (max_dim / h))
                    try:
                        resample_filter = Image.Resampling.LANCZOS
                    except AttributeError:
                        resample_filter = Image.LANCZOS
                    im = im.resize((new_w, new_h), resample_filter)
                
                fd, temp_file_path = tempfile.mkstemp(suffix=".png")
                os.close(fd)
                temp_path = Path(temp_file_path)
                im.save(temp_path, "PNG", optimize=True)
                return temp_path
        except Exception as e:
            print(f"Warning during signature image optimization: {e}")
            return path_obj

