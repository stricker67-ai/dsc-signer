    def _open_pdf(self):
        import subprocess
        try:
            result = subprocess.run(
                [
                    "zenity", "--file-selection", "--multiple", "--separator=|",
                    "--title=Open PDF(s)", 
                    "--file-filter=PDF files | *.pdf *.PDF", 
                    "--file-filter=All files | *"
                ],
                capture_output=True, text=True
            )
            if result.returncode == 0 and result.stdout.strip():
                paths = result.stdout.strip().split('|')
            else:
                paths = []
        except FileNotFoundError:
            selected = filedialog.askopenfilenames(
                title="Open PDF(s)",
                filetypes=[("PDF files", "*.pdf"), ("All files", "*.*")],
            )
            paths = list(selected) if selected else []

        if not paths:
            return
            
        self.pdf_paths = [Path(p) for p in paths]
        self.current_doc_idx = 0
        # Fresh batch — drop positions from any previously opened documents.
        self.page_sig_positions = {}
        self.page_round_positions = {}
        self._load_current_document()

    def _load_current_document(self):
        self.pdf_path = self.pdf_paths[self.current_doc_idx]
        
        doc_msg = f"Doc {self.current_doc_idx + 1} of {len(self.pdf_paths)}"
        self.doc_label.config(text=doc_msg)
        
        self.status_var.set(f"Loading {self.pdf_path.name}...")
        self.update_idletasks()

        try:
            # Get page dimensions from PyPDF
            reader = PdfReader(str(self.pdf_path))
            self.num_pages = len(reader.pages)
            self.pdf_page_sizes = []
            
            if not getattr(self, 'page_sig_positions', None):
                self.page_sig_positions = {}
                
            for i, page in enumerate(reader.pages):
                box = page.mediabox
                w = float(box.width)
                h = float(box.height)
                self.pdf_page_sizes.append((w, h))
                key = (self.current_doc_idx, i)
                if key not in self.page_sig_positions:
                    self.page_sig_positions[key] = (50.0, 50.0, DEFAULT_SIG_W_PT, DEFAULT_SIG_H_PT)

            # Render pages with pdf2image
            self.page_images = convert_from_path(
                str(self.pdf_path), dpi=PREVIEW_DPI,
            )
        except Exception as e:
            messagebox.showerror("Error", f"Failed to load PDF:\n{e}")
            self.status_var.set("Error loading PDF.")
            return

        self.current_page = 0
        self._build_page_checks()
        self._show_page()
        self.status_var.set(f"Loaded {self.pdf_path.name} — {self.num_pages} page(s)")

    def _prev_doc(self):
        if hasattr(self, 'pdf_paths') and self.current_doc_idx > 0:
            self.current_doc_idx -= 1
            self._load_current_document()

    def _next_doc(self):
        if hasattr(self, 'pdf_paths') and self.current_doc_idx < len(self.pdf_paths) - 1:
            self.current_doc_idx += 1
            self._load_current_document()

    def _build_page_checks(self):
        for w in self.pages_frame.winfo_children():
            w.destroy()
        self.page_checks = []

        # Scrollable if many pages
        canvas = tk.Canvas(self.pages_frame, highlightthickness=0)
        scrollbar = ttk.Scrollbar(self.pages_frame, orient=tk.VERTICAL, command=canvas.yview)
        inner = ttk.Frame(canvas)

        inner.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=inner, anchor=tk.NW)
        canvas.configure(yscrollcommand=scrollbar.set)

        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        for i in range(self.num_pages):
            var = tk.BooleanVar(value=(i == self.num_pages - 1))
            cb = ttk.Checkbutton(inner, text=f"Page {i + 1}", variable=var)
            cb.pack(anchor=tk.W)
            self.page_checks.append(var)

        self._mode_changed()

    def _mode_changed(self):
        mode = self.mode_var.get()
        state = tk.NORMAL if mode == "choose" else tk.DISABLED
        for w in self.pages_frame.winfo_children():
            # Reach into the inner frame
            inner_canvas = w
            if isinstance(w, tk.Canvas):
                for child_id in w.find_all():
                    pass
        # Enable/disable checkbuttons via inner frame
        self._set_checks_state(self.pages_frame, state)

    def _set_checks_state(self, widget, state):
        for child in widget.winfo_children():
            if isinstance(child, ttk.Checkbutton):
                child.configure(state=state)
            elif isinstance(child, (ttk.Frame, tk.Frame)):
                self._set_checks_state(child, state)
            elif isinstance(child, tk.Canvas):
                # The inner frame is embedded in the canvas
                for sub in child.winfo_children():
                    self._set_checks_state(sub, state)

    def _compress_changed(self):
        if self.compress_var.get():
            self.compress_details_frame.pack(anchor=tk.W, fill=tk.X)
            self._target_size_changed()
        else:
            self.compress_details_frame.pack_forget()

    def _target_size_changed(self):
        target_enabled = self.target_size_enabled_var.get()
        if target_enabled:
            self.low_comp_btn.configure(state=tk.DISABLED)
            self.medium_comp_btn.configure(state=tk.DISABLED)
            self.high_comp_btn.configure(state=tk.DISABLED)
            self.target_size_entry.configure(state=tk.NORMAL)
        else:
            self.low_comp_btn.configure(state=tk.NORMAL)
            self.medium_comp_btn.configure(state=tk.NORMAL)
            self.high_comp_btn.configure(state=tk.NORMAL)
            self.target_size_entry.configure(state=tk.DISABLED)

    # ── Page Display ─────────────────────────────────────────────────

    def _show_page(self):
        if not self.page_images:
            return

        img = self.page_images[self.current_page]
        page_w_pt, page_h_pt = self.pdf_page_sizes[self.current_page]

        # Scale image to fit canvas
        self.update_idletasks()
        cw = max(self.canvas.winfo_width(), 400)
        ch = max(self.canvas.winfo_height(), 400)

        # Compute scale: canvas pixels per PDF point
        scale_x = cw / page_w_pt
        scale_y = ch / page_h_pt
        self.scale_factor = min(scale_x, scale_y) * 0.95  # slight margin

        display_w = int(page_w_pt * self.scale_factor)
        display_h = int(page_h_pt * self.scale_factor)

        resized = img.resize((display_w, display_h), Image.LANCZOS)
        photo = ImageTk.PhotoImage(resized)
        self._current_photo = photo  # prevent GC

        self.canvas.delete("all")
        # Center image on canvas
        self._img_offset_x = (cw - display_w) // 2
        self._img_offset_y = (ch - display_h) // 2
        self.canvas.create_image(self._img_offset_x, self._img_offset_y,
                                 anchor=tk.NW, image=photo)

        # Restore page-specific coordinates (scoped per document)
        pos_key = (self.current_doc_idx, self.current_page)
        if pos_key in self.page_sig_positions:
            self.sig_x_pt, self.sig_y_pt, self.sig_w_pt, self.sig_h_pt = self.page_sig_positions[pos_key]

        signatory_on = self.signatory_stamp_var.get()
        round_on = self.round_stamp_var.get()

        # When the signatory block is enabled, the signature box *is* the
        # signatory stamp: lock it to the stamp's aspect ratio so the
        # auto-placed DSC field lands inside the "(Signature)" gap.
        if signatory_on:
            self.sig_h_pt = self.sig_w_pt / dsc_stamp.SIGNATORY_ASPECT
            self.page_sig_positions[pos_key] = (
                self.sig_x_pt, self.sig_y_pt, self.sig_w_pt, self.sig_h_pt)

        # Draw signature / signatory box at stored PDF-point position
        bx = self._img_offset_x + self.sig_x_pt * self.scale_factor
        by = self._img_offset_y + self.sig_y_pt * self.scale_factor
        bw = self.sig_w_pt * self.scale_factor
        bh = self.sig_h_pt * self.scale_factor

        self.sig_box = DraggableBox(
            self.canvas, bx, by, bw, bh,
            on_move=self._on_box_moved,
            aspect=dsc_stamp.SIGNATORY_ASPECT if signatory_on else None,
            label_text=None if signatory_on else "Signature",
            pil_image=self._load_stamp_pil(self.signatory_img_path.get())
            if signatory_on else None,
        )
        self._update_pos_display()

        # Draw the optional second signature box (green), if enabled
        self.sig_box2 = None
        if getattr(self, "second_sig_var", None) and self.second_sig_var.get():
            s2x, s2y, s2w, s2h = self.page_sig2_positions.get(
                pos_key, (max(50.0, page_w_pt - 350.0), self.sig_y_pt, 300.0, 80.0))
            self.sig_box2 = DraggableBox(
                self.canvas,
                self._img_offset_x + s2x * self.scale_factor,
                self._img_offset_y + s2y * self.scale_factor,
                s2w * self.scale_factor,
                s2h * self.scale_factor,
                on_move=self._on_box2_moved,
                aspect=None,
                label_text="Signature 2",
                color="#2e7d32",
            )
            self.page_sig2_positions[pos_key] = (s2x, s2y, s2w, s2h)
            self._on_box2_moved()

        # Draw the round company seal box, if enabled
        self.round_box = None
        if round_on:
            rx_pt, ry_pt, rw_pt, rh_pt = self.page_round_positions.get(
                pos_key, (page_w_pt - 170.0, page_h_pt - 190.0, 130.0, 130.0))
            self.round_box = DraggableBox(
                self.canvas,
                self._img_offset_x + rx_pt * self.scale_factor,
                self._img_offset_y + ry_pt * self.scale_factor,
                rw_pt * self.scale_factor,
                rh_pt * self.scale_factor,
                on_move=self._on_round_box_moved,
                aspect=dsc_stamp.ROUND_ASPECT,
                label_text=None,
                color="#1565c0",
                pil_image=self._load_stamp_pil(self.round_img_path.get()),
            )
            self._on_round_box_moved()

        if self.same_pos_var.get():
            self._propagate_positions()

        # Page label
        self.page_label.config(text=f"Page {self.current_page + 1} / {self.num_pages}")

    def _on_box_moved(self):
        """Update stored PDF-point coords from canvas box position."""
        box = self.sig_box
        self.sig_x_pt = (box.x - self._img_offset_x) / self.scale_factor
        self.sig_y_pt = (box.y - self._img_offset_y) / self.scale_factor
        self.sig_w_pt = box.w / self.scale_factor
        self.sig_h_pt = box.h / self.scale_factor
        
        # Save coordinates for the current page
        self.page_sig_positions[(self.current_doc_idx, self.current_page)] = (self.sig_x_pt, self.sig_y_pt, self.sig_w_pt, self.sig_h_pt)
        if self.same_pos_var.get():
            self._propagate_positions()

        self._update_pos_display()

    def _on_round_box_moved(self):
        """Persist the round-seal box position for the current page."""
        box = self.round_box
        if box is None:
            return
        x = (box.x - self._img_offset_x) / self.scale_factor
        y = (box.y - self._img_offset_y) / self.scale_factor
        w = box.w / self.scale_factor
        h = box.h / self.scale_factor
        self.page_round_positions[(self.current_doc_idx, self.current_page)] = (x, y, w, h)
        if self.same_pos_var.get():
            self._propagate_positions()

    def _on_box2_moved(self):
        """Persist the second-signature box position for the current page."""
        box = self.sig_box2
        if box is None:
            return
        x = (box.x - self._img_offset_x) / self.scale_factor
        y = (box.y - self._img_offset_y) / self.scale_factor
        w = box.w / self.scale_factor
        h = box.h / self.scale_factor
        self.page_sig2_positions[(self.current_doc_idx, self.current_page)] = (x, y, w, h)
        if self.same_pos_var.get():
            self._propagate_positions()

    def _propagate_positions(self):
        """Copy the current page's box positions to every page of this document."""
        if not self.page_images:
            return
        doc = self.current_doc_idx
        cur = (doc, self.current_page)
        sig = (self.sig_x_pt, self.sig_y_pt, self.sig_w_pt, self.sig_h_pt)
        sig2 = self.page_sig2_positions.get(cur)
        rnd = self.page_round_positions.get(cur)
        for pg in range(self.num_pages):
            self.page_sig_positions[(doc, pg)] = sig
            if sig2 is not None:
                self.page_sig2_positions[(doc, pg)] = sig2
            if rnd is not None:
                self.page_round_positions[(doc, pg)] = rnd

    def _same_pos_reference(self):
        """The on-screen positions, applied to every page of every document at sign time."""
        cur = (self.current_doc_idx, self.current_page)
        return {
            "sig": (self.sig_x_pt, self.sig_y_pt, self.sig_w_pt, self.sig_h_pt),
            "sig2": self.page_sig2_positions.get(cur),
            "round": self.page_round_positions.get(cur),
        }

    def _same_pos_changed(self):
        if self.same_pos_var.get() and self.page_images:
            self._propagate_positions()
            self._update_pos_display()

    def _load_stamp_pil(self, path):
        """Load (and cache) a stamp image as an RGBA PIL image, or None."""
        if not path or not os.path.exists(path):
            return None
        if path not in self._stamp_pil_cache:
            try:
                self._stamp_pil_cache[path] = Image.open(path).convert("RGBA")
            except Exception:
                self._stamp_pil_cache[path] = None
        return self._stamp_pil_cache[path]

    def _stamps_changed(self):
        """Redraw the current page when a stamp checkbox is toggled."""
        if self.page_images:
            self._show_page()

    def _browse_stamp(self, which):
        """Pick a different image file for the round or signatory stamp."""
        path = filedialog.askopenfilename(
            title=f"Select {which} stamp image",
            filetypes=[("Images", "*.png *.jpg *.jpeg"), ("All files", "*.*")],
        )
        if not path:
            return
        # Copy the chosen stamp into the config folder so it persists across
        # runs and survives the original being moved/deleted.
        try:
            path = dsc_stamp.save_stamp("round" if which == "round" else "signatory", path)
        except Exception:
            pass
        self._stamp_pil_cache.pop(path, None)  # force reload of the new artwork
        if which == "round":
            self.round_img_path.set(path)
            self.round_img_label.config(text=os.path.basename(path))
        else:
            self.signatory_img_path.set(path)
            self.signatory_img_label.config(text=os.path.basename(path))
        self._stamps_changed()

    def _update_pos_display(self):
        self.pos_labels["x"].config(text=f"{self.sig_x_pt:.0f}")
        self.pos_labels["y"].config(text=f"{self.sig_y_pt:.0f}")
        self.pos_labels["w"].config(text=f"{self.sig_w_pt:.0f}")
        self.pos_labels["h"].config(text=f"{self.sig_h_pt:.0f}")

    def _prev_page(self):
        if self.current_page > 0:
            self.current_page -= 1
            self._show_page()

    def _next_page(self):
        if self.current_page < self.num_pages - 1:
            self.current_page += 1
            self._show_page()

    # ── Signing ──────────────────────────────────────────────────────

    def _get_chosen_pages(self):
        """Return list of chosen page indices (only for 'choose' mode)."""
        return [i for i, var in enumerate(self.page_checks) if var.get()]

    def _do_sign(self):
        if not hasattr(self, 'pdf_paths') or not self.pdf_paths:
            messagebox.showwarning("No PDF", "Open a PDF first.")
            return

        pin = self.pin_var.get()
        if not pin:
            messagebox.showwarning("PIN required", "Enter your token PIN.")
            return

        mode = self.mode_var.get()
        chosen_pages = []
        if mode == "choose":
            chosen_pages = self._get_chosen_pages()
            if not chosen_pages:
                messagebox.showwarning("No pages", "Select at least one page to sign.")
                return

        compress_opts = {
            "enabled": self.compress_var.get(),
            "mode": self.compress_mode_var.get(),
            "target_enabled": self.target_size_enabled_var.get(),
            "target_size": int(self.target_size_var.get()) if self.target_size_var.get().isdigit() else 500
        }
        do_ocr = self.ocr_var.get()
        appearance_mode = self.appearance_var.get()

        # Capture stamp settings on the main thread (tk vars / dicts).
        stamp_opts = {
            "round": self.round_stamp_var.get(),
            "signatory": self.signatory_stamp_var.get(),
            "round_img": self.round_img_path.get(),
            "signatory_img": self.signatory_img_path.get(),
            "round_pos": dict(self.page_round_positions),
            "second_sig": self.second_sig_var.get(),
            "sig2_pos": dict(self.page_sig2_positions),
            "same_pos": self._same_pos_reference() if self.same_pos_var.get() else None,
        }

        self.sign_btn.configure(state=tk.DISABLED)
        self.process_btn.configure(state=tk.DISABLED)
        doc_count = len(self.pdf_paths)
        self.status_var.set(f"Signing {doc_count} document(s)...")
        self.update_idletasks()

        # Run signing in a thread to keep UI responsive
        thread = threading.Thread(target=self._sign_thread, args=(pin, mode, chosen_pages, compress_opts, do_ocr, appearance_mode, stamp_opts), daemon=True)
        thread.start()

    def _sign_thread(self, pin, mode, chosen_pages, compress_opts, do_ocr, appearance_mode, stamp_opts):
        from pyhanko.sign.pkcs11 import PKCS11Signer, open_pkcs11_session, TokenCriteria
        import pkcs11 as pk

        success_count = 0
        errors = []
        session = None

        try:
            _resolve_pkcs11()

            session = open_pkcs11_session(
                lib_location=PKCS11_MODULE,
                token_criteria=TokenCriteria(label=TOKEN_LABEL),
                user_pin=pin,
            )

            # Find certificate label
            cert_label = None
            for obj in session.get_objects({pk.Attribute.CLASS: pk.ObjectClass.CERTIFICATE}):
                cert_label = obj[pk.Attribute.LABEL]
                break
            if not cert_label:
                raise RuntimeError("No certificates found on token")

            signer_obj = PKCS11Signer(
                pkcs11_session=session,
                key_label=cert_label,
                cert_label=cert_label,
                use_raw_mechanism=True,
            )

            for doc_idx, path in enumerate(self.pdf_paths):
                try:
                    self._sign_single_pdf(doc_idx, path, signer_obj, mode, chosen_pages, compress_opts, do_ocr, appearance_mode, stamp_opts)
                    success_count += 1
                except Exception as e:
                    errors.append(f"{path.name}: {repr(e)}")

        except Exception as e:
            errors.append(f"Token error: {repr(e)}")
        finally:
            if session:
                try:
                    session.close()
                except Exception:
                    pass

        self.after(0, self._sign_done, success_count, len(self.pdf_paths), errors)

    def _sign_done(self, success_count, total, errors):
        self.sign_btn.configure(state=tk.NORMAL)
        self.process_btn.configure(state=tk.NORMAL)
        if errors:
            err_msg = "\n".join(errors)
            self.status_var.set(f"Signed {success_count}/{total} with errors.")
            messagebox.showerror("Signing Issues", f"Some files failed:\n{err_msg}")
        else:
            self.status_var.set(f"Successfully signed {success_count} document(s).")
            messagebox.showinfo("Success", f"Successfully signed {success_count} document(s).")

    def _do_process(self):
        if not hasattr(self, 'pdf_paths') or not self.pdf_paths:
            messagebox.showwarning("No PDF", "Open a PDF first.")
            return

        mode = self.mode_var.get()
        chosen_pages = []
        if mode == "choose":
            chosen_pages = self._get_chosen_pages()
            do_stamp = self.round_stamp_var.get() or self.signatory_stamp_var.get()
            if do_stamp and not chosen_pages:
                messagebox.showwarning("No pages", "Select at least one page to apply stamps.")
                return

        compress_opts = {
            "enabled": self.compress_var.get(),
            "mode": self.compress_mode_var.get(),
            "target_enabled": self.target_size_enabled_var.get(),
            "target_size": int(self.target_size_var.get()) if self.target_size_var.get().isdigit() else 500
        }
        do_ocr = self.ocr_var.get()
        
        do_stamp = self.round_stamp_var.get() or self.signatory_stamp_var.get()
        if not (compress_opts["enabled"] or do_ocr or do_stamp):
            messagebox.showwarning("No action selected", "Select Compress, OCR, or at least one stamp to apply.")
            return

        # Capture stamp settings on the main thread (tk vars / dicts).
        stamp_opts = {
            "round": self.round_stamp_var.get(),
            "signatory": self.signatory_stamp_var.get(),
            "round_img": self.round_img_path.get(),
            "signatory_img": self.signatory_img_path.get(),
            "round_pos": dict(self.page_round_positions),
            "second_sig": self.second_sig_var.get(),
            "sig2_pos": dict(self.page_sig2_positions),
            "same_pos": self._same_pos_reference() if self.same_pos_var.get() else None,
        }

        self.sign_btn.configure(state=tk.DISABLED)
        self.process_btn.configure(state=tk.DISABLED)
        doc_count = len(self.pdf_paths)
        self.status_var.set(f"Processing {doc_count} document(s)...")
        self.update_idletasks()

        # Run processing in a thread to keep UI responsive
        thread = threading.Thread(
            target=self._process_thread,
            args=(mode, chosen_pages, compress_opts, do_ocr, stamp_opts),
            daemon=True
        )
        thread.start()

    def _process_thread(self, mode, chosen_pages, compress_opts, do_ocr, stamp_opts):
        success_count = 0
        errors = []

        for doc_idx, path in enumerate(self.pdf_paths):
            try:
                self._sign_single_pdf(
                    doc_idx=doc_idx,
                    input_path=path,
                    signer_obj=None,
                    mode=mode,
                    chosen_pages=chosen_pages,
                    compress_opts=compress_opts,
                    do_ocr=do_ocr,
                    appearance_mode=None,
                    stamp_opts=stamp_opts
                )
                success_count += 1
            except Exception as e:
                errors.append(f"{path.name}: {repr(e)}")

        self.after(0, self._process_done, success_count, len(self.pdf_paths), errors)

    def _process_done(self, success_count, total, errors):
        self.sign_btn.configure(state=tk.NORMAL)
        self.process_btn.configure(state=tk.NORMAL)
        if errors:
            err_msg = "\n".join(errors)
            self.status_var.set(f"Processed {success_count}/{total} with errors.")
            messagebox.showerror("Processing Issues", f"Some files failed:\n{err_msg}")
        else:
            self.status_var.set(f"Successfully processed {success_count} document(s).")
            messagebox.showinfo("Success", f"Successfully processed {success_count} document(s).")

    def _sign_single_pdf(self, doc_idx, input_path, signer_obj, mode, chosen_pages, compress_opts, do_ocr, appearance_mode, stamp_opts):
        import subprocess
        import tempfile
        from pyhanko.sign.signers.pdf_signer import PdfSigner
        from pyhanko.stamp.static import StaticStampStyle
        from pyhanko.stamp.text import TextStampStyle
        from pyhanko.pdf_utils.images import PdfImage
        from pyhanko.sign import signers
        from pyhanko.sign.fields import SigFieldSpec
        from pyhanko.pdf_utils.incremental_writer import IncrementalPdfFileWriter
        from pypdf import PdfReader

        if signer_obj is None:
            output_path = input_path.with_stem(input_path.stem + "_processed")
        else:
            output_path = input_path.with_stem(input_path.stem + "_signed")
        
        current_input = input_path
        temp_files = []
        
        if do_ocr:
            fd, temp_file_path = tempfile.mkstemp(suffix=".pdf")
            os.close(fd)
            temp_file_ocr = Path(temp_file_path)
            temp_files.append(temp_file_ocr)
            
            cmd = ["ocrmypdf", "--force-ocr", str(current_input), str(temp_file_ocr)]
            res = subprocess.run(cmd, capture_output=True, text=True)
            if res.returncode != 0:
                for f in temp_files:
                    if f.exists(): f.unlink()
                raise RuntimeError(f"OCR failed: {res.stderr}")
            current_input = temp_file_ocr

        if compress_opts and compress_opts.get("enabled"):
            fd, temp_file_path = tempfile.mkstemp(suffix=".pdf")
            os.close(fd)
            temp_file_compress = Path(temp_file_path)
            temp_files.append(temp_file_compress)
            
            if compress_opts.get("target_enabled"):
                target_kb = compress_opts.get("target_size", 500)
                success = compress_to_target_size(current_input, temp_file_compress, target_kb)
                if not success:
                    for f in temp_files:
                        if f.exists(): f.unlink()
                    raise RuntimeError("Target size compression failed")
            else:
                comp_mode = compress_opts.get("mode", "medium")
                gs_mode = "/ebook"
                if comp_mode == "low":
                    gs_mode = "/printer"
                elif comp_mode == "high":
                    gs_mode = "/screen"
                
                success = run_gs_compress(current_input, temp_file_compress, gs_mode)
                if not success:
                    for f in temp_files:
                        if f.exists(): f.unlink()
                    raise RuntimeError("Compression failed")
            
            current_input = temp_file_compress

        reader = PdfReader(str(current_input))
        num_pages = len(reader.pages)
        page_sizes = [(float(p.mediabox.width), float(p.mediabox.height)) for p in reader.pages]

        stamps_enabled = stamp_opts and (stamp_opts.get("round") or stamp_opts.get("signatory"))
        same_pos = stamp_opts.get("same_pos") if stamp_opts else None  # one box for every page/document

        if signer_obj is not None or stamps_enabled:
            if mode == "last":
                pages_to_sign = [num_pages - 1]
            elif mode == "all":
                pages_to_sign = list(range(num_pages))
            else:
                pages_to_sign = [p for p in chosen_pages if p < num_pages]

            if not pages_to_sign:
                for f in temp_files:
                    if f.exists(): f.unlink()
                return
        else:
            pages_to_sign = []

        # ── Overlay company stamps onto the signed pages (before signing) ──
        stamp_temp = None
        if stamp_opts and (stamp_opts.get("round") or stamp_opts.get("signatory")):
            placements = {}
            for pg in pages_to_sign:
                pg_w, pg_h = page_sizes[pg]
                items = []
                if stamp_opts.get("signatory"):
                    if same_pos:
                        sx, sy, sw, sh = same_pos["sig"]
                    else:
                        sx, sy, sw, sh = self.page_sig_positions.get(
                            (doc_idx, pg),
                            self.page_sig_positions.get((doc_idx, 0), (50.0, 50.0, 300.0, 80.0)))
                    sh = sw / dsc_stamp.SIGNATORY_ASPECT  # keep undistorted
                    items.append((stamp_opts["signatory_img"], sx, sy, sw, sh))
                if stamp_opts.get("round"):
                    if same_pos and same_pos.get("round"):
                        rx, ry, rw, rh = same_pos["round"]
                    else:
                        rx, ry, rw, rh = stamp_opts.get("round_pos", {}).get(
                            (doc_idx, pg), (pg_w - 170.0, pg_h - 190.0, 130.0, 130.0))
                    items.append((stamp_opts["round_img"], rx, ry, rw, rh))
                if items:
                    placements[pg] = items
            if placements:
                fd, stamp_temp_path = tempfile.mkstemp(suffix=".pdf")
                os.close(fd)
                stamp_temp = Path(stamp_temp_path)
                dsc_stamp.apply_stamps(str(current_input), str(stamp_temp), placements)
                current_input = stamp_temp

        if signer_obj is None:
            import shutil
            shutil.copy(str(current_input), str(output_path))
            for f in temp_files:
                if f.exists(): f.unlink()
            if stamp_temp and stamp_temp.exists():
                stamp_temp.unlink()
            return

        stamp_style = None
        appearance_text_params = None
        opt_sig_temp = None
        if appearance_mode == "text":
            from pyhanko.stamp import STAMP_ART_CONTENT
            try:
                signer_name = signer_obj.subject_name or "Unknown Signer"
            except Exception:
                signer_name = "Unknown Signer"
                
            stamp_style = TextStampStyle(
                stamp_text="Digitally signed by %(signer)s.\nTimestamp: %(ts)s.",
                background=STAMP_ART_CONTENT
            )
            appearance_text_params = {
                'signer': signer_name
            }
        else:
            stamp_path = dsc_stamp.SIGNATURE_IMAGE
            if os.path.exists(stamp_path):
                try:
                    opt_sig_temp = self._get_optimized_signature_image(stamp_path)
                    stamp_style = StaticStampStyle(background=PdfImage(str(opt_sig_temp)))
                except Exception:
                    pass

        for page_num in pages_to_sign:
            page_w_pt, page_h_pt = page_sizes[page_num]
            
            # Fetch coordinates for this page, or fallback
            if same_pos:
                sig_x, sig_y, sig_w, sig_h = same_pos["sig"]
            elif (doc_idx, page_num) in self.page_sig_positions:
                sig_x, sig_y, sig_w, sig_h = self.page_sig_positions[(doc_idx, page_num)]
            else:
                sig_x, sig_y, sig_w, sig_h = self.page_sig_positions.get(
                    (doc_idx, 0), (50.0, 50.0, 150.0, 50.0))

            # With the signatory block enabled, the DSC field is placed
            # inside the stamp's blank "(Signature)" gap, not the whole box.
            if stamp_opts and stamp_opts.get("signatory"):
                sig_h = sig_w / dsc_stamp.SIGNATORY_ASPECT
                sig_x, sig_y, sig_w, sig_h = dsc_stamp.gap_rect(
                    (sig_x, sig_y, sig_w, sig_h))

            x1 = max(0, sig_x)
            y_bottom = page_h_pt - sig_y - sig_h
            y1 = max(0, y_bottom)
            x2 = x1 + sig_w
            y2 = y1 + sig_h

            field_name = f"DSC_Signature_{page_num + 1}"

            with open(current_input, "rb") as inf:
                writer = IncrementalPdfFileWriter(inf, strict=False)
                sig_field = SigFieldSpec(
                    sig_field_name=field_name,
                    on_page=page_num,
                    box=(x1, y1, x2, y2),
                )
                pdf_signer = PdfSigner(
                    signers.PdfSignatureMetadata(field_name=field_name),
                    signer_obj,
                    new_field_spec=sig_field,
                    stamp_style=stamp_style
                )
                if appearance_mode == "text" and appearance_text_params:
                    out = pdf_signer.sign_pdf(writer, appearance_text_params=appearance_text_params)
                else:
                    out = pdf_signer.sign_pdf(writer)
                
            with open(output_path, "wb") as outf:
                outf.write(out.getvalue())

            current_input = output_path

            # ── Optional second DSC signature on the same page ──
            if stamp_opts and stamp_opts.get("second_sig"):
                if same_pos and same_pos.get("sig2"):
                    s2 = same_pos["sig2"]
                else:
                    s2 = stamp_opts.get("sig2_pos", {}).get(
                        (doc_idx, page_num),
                        stamp_opts.get("sig2_pos", {}).get(
                            (doc_idx, 0),
                            (max(50.0, page_w_pt - 350.0), 50.0, 300.0, 80.0)))
                s2x, s2y, s2w, s2h = s2
                bx1 = max(0, s2x)
                by1 = max(0, page_h_pt - s2y - s2h)
                field2 = f"DSC_Signature_{page_num + 1}_2"
                with open(current_input, "rb") as inf2:
                    writer2 = IncrementalPdfFileWriter(inf2, strict=False)
                    sig_field2 = SigFieldSpec(
                        sig_field_name=field2, on_page=page_num,
                        box=(bx1, by1, bx1 + s2w, by1 + s2h))
                    pdf_signer2 = PdfSigner(
                        signers.PdfSignatureMetadata(field_name=field2),
                        signer_obj, new_field_spec=sig_field2,
                        stamp_style=stamp_style)
                    if appearance_mode == "text" and appearance_text_params:
                        out2 = pdf_signer2.sign_pdf(
                            writer2, appearance_text_params=appearance_text_params)
                    else:
                        out2 = pdf_signer2.sign_pdf(writer2)
                with open(output_path, "wb") as outf2:
                    outf2.write(out2.getvalue())
                current_input = output_path

        for f in temp_files:
            if f.exists(): f.unlink()
        if stamp_temp and stamp_temp.exists():
            stamp_temp.unlink()
        if opt_sig_temp and opt_sig_temp != Path(stamp_path) and opt_sig_temp.exists():
            opt_sig_temp.unlink()

    def _on_close(self):
        try:
            self.config_dir.mkdir(parents=True, exist_ok=True)
            import json
            if self.wm_state() == "normal":
                config = {"geometry": self.geometry(), "same_pos": self.same_pos_var.get()}
                with open(self.config_file, "w") as f:
                    json.dump(config, f)
        except Exception:
            pass
        self.destroy()


def main():
    initial_files = sys.argv[1:] if len(sys.argv) > 1 else None
    app = PDFSignerApp(initial_files=initial_files)
    app.mainloop()


if __name__ == "__main__":
    main()
